    "@pricing-engine/api": "workspace:*"
  },
  "devDependencies": {
    "aws-cdk": "2.1144.0",
    "tsx": "4.23.15",
    "vitest": "4.1.11",
    "typescript": "5.9.3",
    "@types/node": "24.19.1"
  }
}